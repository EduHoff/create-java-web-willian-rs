<?xml version="1.0" encoding="UTF-8"?>
<project name="project_name" default="dist" basedir=".">
    <description>Script de build generico para Java Web (Tomcat)</description>

    <property name="src.dir" location="src/java"/>
    <property name="web.dir" location="web"/>
    <property name="build.dir" location="build"/>
    <property name="classes.dir" location="${build.dir}/classes"/>
    <property name="dist.dir" location="dist"/>
    <property name="lib.dir" location="web/WEB-INF/lib"/>

    <path id="classpath">
        <fileset dir="${lib.dir}" erroronmissingdir="false">
            <include name="*.jar"/>
        </fileset>
    </path>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="init">
        <mkdir dir="${classes.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>

    <target name="compile" depends="init">
        <javac srcdir="${src.dir}" destdir="${classes.dir}" includeantruntime="false" debug="true">
            <classpath refid="classpath"/>
        </javac>
    </target>

    <target name="dist" depends="clean, compile">
        <war destfile="${dist.dir}/project_name.war" needxmlfile="false">
            <fileset dir="${web.dir}"/>
            <classes dir="${classes.dir}"/>
        </war>
    </target>
</project>
